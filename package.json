{
  "name": "ionara-web-shop",
  "version": "2.0.0",
  "private": true,
  "description": "IONARA Tunisia — French, English and Arabic gaming storefront",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "dev": "node scripts/start.cjs",
    "build": "npm --prefix frontend run build",
    "start": "node scripts/start.cjs --production",
    "test": "npm --prefix backend test",
    "test:browser": "playwright test",
    "test:i18n": "node --test tests/i18n.test.cjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  }
}